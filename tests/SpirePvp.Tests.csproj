<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <PropertyGroup Condition="'$(LanOnly)' == 'true'"><DefineConstants>$(DefineConstants);LAN_ONLY</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(LanOnly)' == 'true'">
    <Compile Remove="Program.cs;CharacterModFixtures.cs;MintyDisplayFixture.cs" />
