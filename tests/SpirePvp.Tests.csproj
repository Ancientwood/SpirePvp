  </ItemGroup>
  <ItemGroup Condition="'$(LanOnly)' != 'true'"><ProjectReference Include="../SpirePvp/SpirePvp.csproj" /></ItemGroup>
  <PropertyGroup><GameDir Condition="'$(GameDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</GameDir></PropertyGroup>
  <PropertyGroup><BaseLibPath Condition="'$(BaseLibPath)' == ''">$(GameDir)\..\..\workshop\content\2868840\3737335127\BaseLib\BaseLib.dll</BaseLibPath></PropertyGroup>
  <Import Project="../local.props" Condition="Exists('../local.props')" />
  <ItemGroup Condition="'$(LanOnly)' != 'true'">
    <Reference Include="BaseLib"><HintPath>$(BaseLibPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="sts2"><HintPath>$(GameDir)/data_sts2_windows_x86_64/sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)/data_sts2_windows_x86_64/GodotSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)/data_sts2_windows_x86_64/0Harmony.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
